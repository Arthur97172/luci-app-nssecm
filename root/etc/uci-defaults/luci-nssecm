#
# uci-defaults script - executed exactly once, on the first boot after the
# package has been installed. Exiting with 0 makes the OpenWrt build system
# delete this script again, so it never runs twice.
#
# It registers an ucitrack entry so that applying a change to the ecm config
# through LuCI also restarts the qca-nss-ecm service.
#
# The ecm config itself is NOT created here: it belongs to the Qualcomm
# kmod-qca-nss-ecm-* packages, and the menu entry is hidden until it exists
# (see root/usr/share/luci/menu.d/luci-app-nssecm.json). Creating it here would
# offer the page on devices whose acceleration engine is not installed.

uci -q batch <<-EOF >/dev/null
	delete ucitrack.@ecm[-1]
	add ucitrack ecm
	set ucitrack.@ecm[-1].init=qca-nss-ecm
	commit ucitrack
EOF

rm -f /tmp/luci-indexcache

exit 0
